{
  "name": "@usesimpler/api-schema",
  "version": "0.0.0",
  "description": "Integrator schema package for the Simpler API surface. A dependency of the Simpler API client, not a library integrators import directly.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usesimpler/sdk.git",
    "directory": "packages/api-schema"
  },
  "bugs": {
    "url": "https://github.com/usesimpler/sdk/issues"
  },
  "homepage": "https://github.com/usesimpler/sdk#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./parse-result": {
      "types": "./dist/parse-result.d.ts",
      "import": "./dist/parse-result.js",
      "default": "./dist/parse-result.js"
    },
    "./site-listing": {
      "types": "./dist/listings/site-listing.d.ts",
      "import": "./dist/listings/site-listing.js",
      "default": "./dist/listings/site-listing.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "biome lint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "openapi:generate": "pnpm run build && node ./scripts/generate-public-openapi.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
