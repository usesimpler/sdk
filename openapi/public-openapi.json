  "paths": {
    "/v1/listings": {
      "get": {
        "summary": "List listings for a Site API key",
        "tags": [
          "Integrator",
          "Listings"
        ],
        "security": [
          {
            "SiteApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Site API key listing list. Address, price, description, dates, Stage name, and agent name, phone, and photo. Omits seller, seller contact id, Meta campaign ids, org id, team id, accepted Offer, agent email, and agent member ids.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteListListingsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/listings/{id}": {
      "get": {
        "summary": "Get a listing for a Site API key",
        "tags": [
          "Integrator",
          "Listings"
        ],
        "security": [
          {
            "SiteApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Public listing. Address, price, description, dates, Stage name, and agent name, phone, and photo. Omits seller, seller contact id, Meta campaign ids, org id, team id, accepted Offer, agent email, and agent member ids.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteListing"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/listings/{id}/media": {
      "get": {
        "summary": "Listing media for a Site API key",
        "tags": [
          "Integrator",
          "Listings"
        ],
        "security": [
          {
            "SiteApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Listing media items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ListingMediaItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/site": {
      "get": {
        "summary": "Get the Site implied by a Site API key",
        "tags": [
          "Integrator",
          "Sites"
        ],
        "security": [
          {
            "SiteApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Site branding and listing scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSite"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Site API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/pages": {
      "get": {
        "summary": "List Pages as a title-ordered tree",
        "tags": [
          "Integrator",
          "Pages"
        ],
        "security": [
          {
            "SiteApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Page tree (no section HTML)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageTree"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Site API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/pages/{slug}": {
      "get": {
        "summary": "Get a Page by slug with its Sections",
        "tags": [
          "Integrator",
          "Pages"
        ],
        "security": [
          {
            "SiteApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Page with sections",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageWithSections"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Site API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Unknown slug",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
